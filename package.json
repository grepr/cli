{
  "name": "@grepr/cli",
  "version": "1.6.47-42b9ecd",
  "description": "Official Grepr CLI tool for submitting synchronous batch jobs with OAuth authentication",
  "main": "build/dist/grepr.js",
  "type": "module",
  "scripts": {
    "build": "eslint src/**/*.ts && tsc --noEmit && tsc && tsc-alias --resolve-full-paths && chmod +x build/dist/grepr.js && tsx scripts/build-docs-index.ts",
    "build:fast": "tsc && tsc-alias --resolve-full-paths && chmod +x build/dist/grepr.js && tsx scripts/build-docs-index.ts",
    "build:no-index": "tsc && tsc-alias --resolve-full-paths && chmod +x build/dist/grepr.js",
    "build:docs-index": "tsx scripts/build-docs-index.ts",
    "start": "bun run build:fast && node build/dist/grepr.js --version",
    "dev": "tsc --watch",
    "clean": "rm -rf build/dist build/customer-distributions",
    "typecheck": "eslint src/**/*.ts && tsc --noEmit",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "test": "./scripts/run-tests.sh",
    "test:watch": "bun test --watch",
    "test:coverage": "BUN_TEST_FLAGS=--coverage ./scripts/run-tests.sh",
    "verify": "bun run typecheck && bun run test",
    "prepublishOnly": "node -e \"const fs=require('fs');const p=JSON.parse(fs.readFileSync('package.json'));delete p.packageManager;fs.writeFileSync('package.json',JSON.stringify(p,null,2))\" && bun run clean && bun run build",
    "pack": "bun run clean && bun run build && bun pm pack",
    "dist": "./scripts/create-distributions.sh",
    "dist:fast": "bun run build:fast && ./scripts/create-distributions.sh",
    "link:local": "bun run build && bun link",
    "unlink:local": "bun unlink"
  },
  "bin": {
    "grepr": "build/dist/grepr.js"
  },
  "files": [
    "build/dist/**/*",
    "package.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@xenova/transformers": "^2.17.0",
    "axios": "^1.15.2",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dayjs": "^1.11.18",
    "fs-extra": "^11.1.1",
    "open": "^9.1.0",
    "openapi-fetch": "^0.15.0",
    "patch-package": "^8.0.1",
    "vectra": "^0.9.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "glob": "^10.3.0",
    "mdx-bundler": "^10.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rehype-parse": "^9.0.1",
    "rehype-remark": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-stringify": "^11.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.53.1",
    "unified": "^11.0.5"
  },
  "resolutions": {
    "tar": "^7.5.16",
    "axios": "^1.15.2",
    "minimatch": "^10.0.1",
    "flatted": "^3.4.2",
    "undici": "^7.28.0",
    "protobufjs": "^7.6.3",
    "@protobufjs/utf8": "^1.1.1",
    "vite": "^8.0.16",
    "postcss": "^8.5.10",
    "follow-redirects": "^1.16.0",
    "esbuild": "^0.28.1",
    "form-data": "^4.0.6",
    "tmp": "^0.2.6",
    "uuid": "^11.1.1",
    "eslint/js-yaml": "^4.2.0",
    "@eslint/eslintrc/js-yaml": "^4.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "grepr",
    "cli",
    "oauth",
    "logs",
    "query",
    "observability",
    "monitoring",
    "data-analysis"
  ],
  "author": "Grepr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grepr/cli.git"
  },
  "homepage": "https://grepr.ai",
  "bugs": {
    "email": "support@grepr.ai"
  },
  "publishConfig": {
    "access": "public"
  }
}
